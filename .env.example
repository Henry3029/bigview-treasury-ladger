# --- BLOCKCHAIN (HARDHAT/FOUNDRY) ---
# The private key of the deployer account (NEVER share the real .env)
PRIVATE_KEY=0x_your_private_key_here

# RPC URLs for deployment and testing
ALCHEMY_API_KEY=your_alchemy_api_key_here
INFURA_API_KEY=your_infura_api_key_here

# Block Explorer API Keys (for verifying contracts)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- FRONTEND (NEXT.JS) ---
# The Chain ID (e.g., 1 for Mainnet, 11155111 for Sepolia Testnet)
NEXT_PUBLIC_CHAIN_ID=11155111

# Your Smart Contract Addresses
NEXT_PUBLIC_TREASURY_ADDRESS=0x_treasury_contract_address_here
NEXT_PUBLIC_TOKEN_ADDRESS=0x_bvw_token_address_here

# Mock sBTC or other ERC-20 Reward Token Address
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=0x_reward_token_address_here

# --- PROVIDER SETTINGS ---
# The URL of your Ethereum/L2 RPC provider
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key