# --- BACKEND (FOUNDRY / DEPLOYMENT) ---
# DO NOT EXPOSE THIS. Use a fresh burner wallet for testing.
PRIVATE_KEY=0x_your_private_key_here
# API Key for verifying contracts on Basescan/Etherscan
ETHERSCAN_API_KEY=your_block_explorer_api_key_here
# Your RPC provider URL (Alchemy, Infura, etc.)
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/your_api_key

# --- FRONTEND (NEXT.JS) ---
# The Chain ID for Base Sepolia is 84532
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://base-sepolia.g.alchemy.com/v2/your_api_key

# --- SMART CONTRACT ADDRESSES ---
NEXT_PUBLIC_TREASURY_ADDRESS=0x_treasury_contract_address_here
NEXT_PUBLIC_TOKEN_ADDRESS=0x_bvw_token_address_here
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=0x_reward_token_address_here
# No "NEXT_PUBLIC" prefix = Server Only (More Secure)
BIGVIEW_PROFIT_WALLET=0xYourRealWalletAddressHere
ZEROX_API_KEY=your_0x_key_here
AERODROME_API_URL=https://api.aerodrome.finance/v1/pools